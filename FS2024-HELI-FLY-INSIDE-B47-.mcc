          <line>&gt; UUU.UUU |&gt; QQQ.QQ</line>
          <line>^ ZZZ.ZZZ |^ HHH.HH</line>
          <line>XPDR IIII  MODE $$$$</line>
        </display>
        <preconditions>
          <precondition type="config" active="true" ref="03bcbb24-12f6-47b3-80fb-927099cd7561" operand="=" value="1" logic="and" />
