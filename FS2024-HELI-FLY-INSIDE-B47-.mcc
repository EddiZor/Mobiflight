        <test type="Float" value="1" />
        <modifiers>
          <transformation active="False" expression="$" />
          <comparison active="True" value="0" operand="=" ifValue="'SBY'" elseValue="if($=1,'TA','TA/RA')" />
        </modifiers>
        <display type="LcdDisplay" serial="MEGA-2560-03-RGT/ SN-5FC-1CF" trigger="normal" address="LCD-DSP-20-4">
          <line>COM 1     |NAV 1 1/4</line>
          <line>&gt; UUU.UUU |&gt; QQQ.QQ</line>
          <line>^ ZZZ.ZZZ |^ HHH.HH</line>
          <line>XPDR IIII MODE $$$$$</line>
        </display>
        <preconditions>
          <precondition type="config" active="true" ref="03bcbb24-12f6-47b3-80fb-927099cd7561" operand="=" value="0" logic="and" />
        </preconditions>
        <configrefs>
          <configref active="True" ref="c9472882-9e30-4197-b3fb-9b9287b18bcc" placeholder="Z" testvalue="1" />
          <configref active="True" ref="b1175267-ab4c-4e11-8cdd-a456180a7d42" placeholder="U" testvalue="1" />
          <configref active="True" ref="24ac43f6-c20d-47bb-ad5c-00e23061f9ae" placeholder="H" testvalue="1" />
          <configref active="True" ref="e5cce8ef-bf93-4e62-a341-619aef923a87" placeholder="Q" testvalue="1" />
          <configref active="True" ref="21dc00ed-d401-49c6-a7cb-ed6656b76eef" placeholder="I" testvalue="1" />
        </configrefs>
      </settings>
    </config>
    <config guid="2b3ba119-9712-420b-ae0b-de5f6342093c">
      <active>true</active>
      <description>LCD 1 PAGE 2</description>
