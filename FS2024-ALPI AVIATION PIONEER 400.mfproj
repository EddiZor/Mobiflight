          }
        },
        {
          "Source": {
            "SimConnectValue": {
              "UUID": "0",
              "Value": "(A:PLANE BANK DEGREES, degrees) abs 90 > if{ 0 (>L:Normal_Timer, seconds) (L:Inverted_Timer, seconds) 0 == if{ (E:ABSOLUTE TIME, seconds) (>L:Inverted_Timer, seconds) 0 } els{ (E:ABSOLUTE TIME, seconds) (L:Inverted_Timer, seconds) - 5 > if{ 1 } els{ 0 } } } els{ 0 (>L:Inverted_Timer, seconds) (L:Normal_Timer, seconds) 0 == if{ (E:ABSOLUTE TIME, seconds) (>L:Normal_Timer, seconds) 0 } els{ (E:ABSOLUTE TIME, seconds) (L:Normal_Timer, seconds) - 5 > if{ 2 } els{ 0 } } }",
              "VarType": 2
            },
            "Type": "SimConnectSource"
          },
          "TestValue": {
            "type": 1,
            "Float64": 1.0
          },
          "AnalogInputConfig": {
            "onChange": {
              "Command": "@ 1 == if{ 2 (>L:Fuel_Selector_Pos, Number) }\n\n@ 2 == if{ 1 (>L:Fuel_Selector_Pos, Number) }",
              "PresetId": "0",
              "Type": "MSFS2020CustomInputAction"
            }
          },
          "DeviceType": "InputAction",
