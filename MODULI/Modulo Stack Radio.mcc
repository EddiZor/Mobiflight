          <line>XPDR IIII  MODE $$$$</line>
        </display>
        <preconditions>
          <precondition type="config" active="true" ref="03bcbb24-12f6-47b3-80fb-927099cd7561" operand="=" value="1" logic="and" />
        </preconditions>
        <configrefs>
          <configref active="True" ref="35a540a0-46d2-4eea-9fcc-4da006e9d041" placeholder="Z" testvalue="1" />
